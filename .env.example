# Environment configuration template for Last Mile
# Do NOT place real secrets in this file. Copy to .env.local for local development.

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo Mode & Simulated Clock (strictly blocked in production)
NEXT_PUBLIC_DEMO_MODE=true
DEMO_CLOCK_SECRET=demo-secret-key-change-me

# Rate Limiting (Upstash / Redis) - Optional for local dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
